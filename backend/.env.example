# TravelX Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Connection String (leave empty to use in-memory dynamic storage fallback)
MONGODB_URI=mongodb://localhost:27017/travelx

# JWT Secret for authentication tokens
JWT_SECRET=travelx_super_secret_jwt_key_2026_modern_travel_explorer

# Optional External API Keys (Graceful fallbacks built-in when not provided)
# OpenTripMap API Key (Free tier at https://opentripmap.io)
OPENTRIPMAP_API_KEY=

# Google Maps / Places API Key (Optional)
MAPS_API_KEY=

# AI Recommendation Engine Key (OpenAI / Gemini / Anthropic - Optional)
AI_API_KEY=
